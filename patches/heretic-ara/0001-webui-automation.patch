+    def update_pareto_snapshots(trial: Trial) -> None:
+        # ARA-LoRA ablation runs LBFGS warm-started from process-local adapter
+        # state (reset_model() only zeroes lora_B), so re-running it in a fresh
+        # process does not reproduce the scored trial. Persist the LoRA weights
+        # of trials on the current Pareto front so exports can restore them.
+        entries = []
+        for candidate in trial.study.trials:
+            if candidate.number != trial.number and candidate.state != TrialState.COMPLETE:
+                continue
+            attrs = candidate.user_attrs
+            if "refusals" not in attrs or "kl_divergence" not in attrs:
+                continue
+            entries.append((attrs["refusals"], attrs["kl_divergence"], attrs["index"]))
+        entries.sort(key=lambda entry: (entry[0], entry[1]))
+        front = set()
+        min_divergence = math.inf
+        for refusals, kl_divergence, index in entries:
+            if kl_divergence < min_divergence:
+                min_divergence = kl_divergence
+                front.add(index)
+        snapshot_root = os.path.join(settings.study_checkpoint_dir, "trial_snapshots")
+        if os.path.isdir(snapshot_root):
+            for name in os.listdir(snapshot_root):
+                if not name.startswith("trial_"):
+                    continue
+                try:
+                    index = int(name.split("_", 1)[1])
+                except ValueError:
+                    continue
+                if index not in front:
+                    shutil.rmtree(os.path.join(snapshot_root, name), ignore_errors=True)
+        current_index = trial.user_attrs["index"]
+        if current_index in front:
+            weights = {
+                name: parameter.detach().cpu().contiguous()
+                for name, parameter in model.model.named_parameters()
+                if "lora_A" in name or "lora_B" in name
+            }
+            path = snapshot_path(current_index)
+            try:
+                os.makedirs(os.path.dirname(path), exist_ok=True)
+                save_file(weights, path)
+                print(f"* Saved adapter snapshot for trial {current_index}.")
+            except OSError as error:
+                print(f"* WARNING: Could not save adapter snapshot: {error}")
+
+    def restore_adapter_snapshot(trial_number: int) -> bool:
+        path = snapshot_path(trial_number)
+        if not os.path.isfile(path):
+            return False
+        print("* Resetting model...")
+        model.reset_model()
+        print("* Loading adapter snapshot...")
+        weights = load_file(path)
+        parameters = dict(model.model.named_parameters())
+        missing = [name for name in weights if name not in parameters]
+        if missing:
+            raise RuntimeError(
+                f"Adapter snapshot does not match the model (missing {missing[0]})"
+            )
+        with torch.no_grad():
+            for name, value in weights.items():
+                parameters[name].copy_(
+                    value.to(parameters[name].device, parameters[name].dtype)
+                )
+        print(f"* Restored adapter snapshot for trial {trial_number}.")
+        return True
